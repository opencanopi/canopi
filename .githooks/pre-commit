#!/bin/sh
# Tracked git hook (2.1-M14, 2.1-M196): core.hooksPath is the shared relative .githooks, so each worktree runs its own
# copy. Plain node: the gate's entry runs the gate on nvm's engines Node, or refuses naming it (design check AR24).
cd "$(git rev-parse --show-toplevel)" || exit 1
if [ -d .git ] && [ -z "${CANOPI_ALLOW_MAIN_CHECKOUT_COMMIT:-}" ] && [ -z "${GITHUB_ACTIONS:-}" ] \
  && [ -n "${CLAUDECODE:-}${CLAUDE_CODE:-}${CORAL_SESSION_ID:-}${CORAL_DIR:-}${CORAL_URL:-}${ANTIGRAVITY_AGENT:-}${AGY_SESSION:-}${CODEX_CI:-}" ]; then
  echo "pre-commit: refusing agent commit in the main checkout; work in a worktree under .rq-scratch/ (set CANOPI_ALLOW_MAIN_CHECKOUT_COMMIT=1 for an intentional main-checkout commit)" >&2
  exit 1
fi
exec node policy/gate/cli.mjs commit-gate pre-commit "$@"
