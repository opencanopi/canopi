#!/bin/sh
# Tracked git hook (2.1-M14, 2.1-M196): core.hooksPath is the shared relative .githooks, so each worktree runs its own
# copy. Plain node: the gate's entry runs the gate on nvm's engines Node, or refuses naming it (design check AR24).
cd "$(git rev-parse --show-toplevel)" || exit 1
exec node policy/gate/cli.mjs commit-gate commit-msg "$@"
