{
  "version": 1,
  "analyses": [
    {
      "id": "terrain.slope",
      "version": 1,
      "group": "terrain",
      "lane": { "kind": "geolibre_windowed", "halo": 2 },
      "inputs": [
        {
          "key": "dem",
          "accepts": [{ "kind": "raster", "quantity": "ground-elevation" }],
          "requires": ["projected-metre-grid", "metre-values"]
        }
      ],
      "params": [
        {
          "key": "unit",
          "kind": { "type": "choice", "options": ["degrees", "percent"] },
          "default": null,
          "advanced": false,
          "visible_when": null
        }
      ],
      "outputs": [
        {
          "key": "slope",
          "item": { "kind": "raster", "quantity": "slope" },
          "units": { "kind": "by_param", "param": "unit", "map": { "degrees": "°", "percent": "%" } },
          "optional": false,
          "default_selected": true,
          "presentable": true
        }
      ]
    }
  ]
}
