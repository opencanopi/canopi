{
  "$comment": "Edition capabilities table (ADR 0030; 2.1-Q111, 2.1-M13, 2.1-M164). Single source of truth for Desktop vs Web differences; bindings-gen emits desktop/web/src/generated/edition-capabilities.ts.",
  "capabilities": [
    {
      "id": "file-home",
      "kind": "gate",
      "lacks": ["web"],
      "reason": "a page has no file paths",
      "instead": "Drafts, Download a copy; the welcome screen and save status show storage persistence",
      "decided": "2.1-Q111"
    },
    {
      "id": "quit-app",
      "kind": "gate",
      "lacks": ["web"],
      "reason": "a page cannot own the window or its tab",
      "instead": "the browser's",
      "decided": "2.1-Q111"
    },
    {
      "id": "window-chrome",
      "kind": "adapter",
      "lacks": ["web"],
      "reason": "a page cannot own the window or its tab",
      "instead": "the browser's",
      "decided": "2.1-Q144"
    },
    {
      "id": "remembered-window-position",
      "kind": "adapter",
      "lacks": ["desktop-wayland"],
      "reason": "Wayland lets no app place its own window",
      "instead": "the compositor places it; the size is restored",
      "decided": "2.1-Q367"
    },
    {
      "id": "second-copy-prevention",
      "kind": "adapter",
      "lacks": ["web"],
      "reason": "a browser cannot stop a second tab",
      "instead": "the tab-conflict state",
      "decided": "2.1-Q111"
    },
    {
      "id": "linux-trackpad-pinch-note",
      "kind": "gate",
      "lacks": ["web", "desktop-non-linux"],
      "reason": "WebKitGTK sends no pinch",
      "instead": "none needed",
      "decided": "2.1-Q111"
    },
    {
      "id": "geocoder-user-agent",
      "kind": "adapter",
      "lacks": ["web"],
      "reason": "Chromium ignores a script-set User-Agent, so it cannot be relied on in every engine",
      "instead": "the Referer identifies Canopi (same behaviour)",
      "decided": "2.1-Q91"
    },
    {
      "id": "save-as-path",
      "kind": "gate",
      "lacks": ["web"],
      "reason": "no save-to-path in every engine",
      "instead": "Download a copy, reported as downloaded",
      "decided": "2.1-Q111"
    },
    {
      "id": "app-updater",
      "kind": "gate",
      "lacks": ["web"],
      "reason": "a page is updated by its deploy",
      "instead": "the New version: Reload notice",
      "decided": "2.1-Q123"
    },
    {
      "id": "jobs-outliving-window",
      "kind": "adapter",
      "lacks": ["web"],
      "reason": "no work after a tab closes",
      "instead": "Interrupted with Run again",
      "decided": "2.1-Q61"
    },
    {
      "id": "durable-storage",
      "kind": "adapter",
      "lacks": ["web"],
      "reason": "browsers evict and cap storage",
      "instead": "the persistence request and Download a copy, also per Draft on the welcome screen",
      "decided": "2.1-Q82"
    },
    {
      "id": "my-location",
      "kind": "gate",
      "lacks": ["desktop-macos"],
      "reason": "wry maps no geolocation permission there; on Linux and Windows the host grants it to the app origin only",
      "instead": "none",
      "decided": "2.1-Q146"
    },
    {
      "id": "site-data-over-web-limit",
      "kind": "adapter",
      "lacks": ["web"],
      "reason": "quota, 4 GiB wasm memory",
