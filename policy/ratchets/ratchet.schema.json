{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ratchet.schema.json",
  "title": "Ratchet family file (contracts §12, 2.1-M186)",
  "description": "One file per rule family in policy/ratchets/, named <family>.json. A named family lists its violations under entries; a count family holds one count. policy/check.mjs validates every family file against this schema with a validator that refuses any keyword it does not implement.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "family", "ledger", "tool", "scope", "lane"],
  "properties": {
    "$schema": { "const": "./ratchet.schema.json" },
    "version": { "const": 1 },
    "family": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "ledger": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+-[EMQ][0-9]+$" },
    "tool": {
      "enum": ["dependency-cruiser", "ast-grep", "oxlint", "knip", "jscpd", "clippy", "tsc", "cargo-deny", "cargo-shear", "osv", "file-size"]
    },
    "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "lane": { "enum": ["commit", "push", "ci"] },
    "keys": { "enum": ["path", "path-rule", "name"] },
    "entries": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "count": { "type": "integer", "minimum": 1 },
          "bead": { "type": "string", "pattern": "^canopi-[a-z0-9]+(\\.[0-9]+)*$" }
        }
      }
    },
    "count": { "type": "integer", "minimum": 0 }
  },
  "oneOf": [
    { "required": ["keys", "entries"], "properties": { "count": false } },
    { "required": ["count"], "properties": { "keys": false, "entries": false } }
  ]
}
