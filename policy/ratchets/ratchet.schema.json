{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ratchet.schema.json",
  "title": "Ratchet family file (contracts §12, 2.1-M186, 2.1-M222)",
  "description": "One file per rule family in policy/ratchets/, named <family>.json, of one of three kinds (2.1-M222): a ratchet, whose named entries or one count only shrink; a budget, a ceiling and a tolerance per key, failing only above the ceiling times one plus the tolerance; a floor, per-tool floors with the include and exclusion patterns they are measured over, failing below a floor. policy/check.mjs validates every family file against this schema with a validator that refuses any keyword it does not implement.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "family", "ledger", "tool", "scope", "lane"],
  "properties": {
    "$schema": { "const": "./ratchet.schema.json" },
    "version": { "const": 1 },
    "family": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "ledger": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+-[EMQ][0-9]+$" },
    "tool": {
      "description": "The tool that reports this family's sites. Its adapter, policy/adapters/<tool>.mjs, turns the tool's output into the sites compare() takes; policy/check.mjs refuses a tool with no adapter, so a tool joins with its adapter and this schema lists none (2.1-M189).",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "lane": { "enum": ["commit", "push", "ci"] },
    "keys": { "enum": ["path", "path-rule", "name"] },
    "entries": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "count": { "type": "integer", "minimum": 1 },
          "bead": { "type": "string", "pattern": "^canopi-[a-z0-9]+(\\.[0-9]+)*$" }
        }
      }
    },
    "count": { "type": "integer", "minimum": 0 },
    "budgets": {
      "description": "A budget family's keys, each a measured name (a chunk, a timing) with its ceiling and its tolerance, a fraction of the ceiling.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ceiling", "tolerance"],
        "properties": {
          "ceiling": { "type": "number", "minimum": 0 },
          "tolerance": { "type": "number", "minimum": 0 },
          "bead": { "type": "string", "pattern": "^canopi-[a-z0-9]+(\\.[0-9]+)*$" }
        }
      }
    },
    "floors": {
      "description": "A floor family's tools, each with its floors per metric (percentages) and the include and exclusion patterns, in the tool's own pattern language, it is measured over.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["floors"],
        "properties": {
          "include": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "exclude": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "floors": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "type": "string", "pattern": "^[a-z]+$" },
            "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      }
    }
  },
  "oneOf": [
    { "required": ["keys", "entries"], "properties": { "count": false, "budgets": false, "floors": false } },
    { "required": ["count"], "properties": { "keys": false, "entries": false, "budgets": false, "floors": false } },
    { "required": ["budgets"], "properties": { "keys": false, "entries": false, "count": false, "floors": false } },
    { "required": ["floors"], "properties": { "keys": false, "entries": false, "count": false, "budgets": false } }
  ]
}
