{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["../desktop/web/node_modules/@types"],
    "paths": {
      "vitest": ["../desktop/web/node_modules/vitest/dist/index.d.ts"],
      "typescript": ["../desktop/web/node_modules/typescript/lib/typescript.d.ts"]
    }
  },
  "include": ["gate"]
}
