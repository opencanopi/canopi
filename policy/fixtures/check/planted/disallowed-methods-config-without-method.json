{
  "toolLane": "push",
  "lane": "push",
  "real": true,
  "copyDirs": [
    "policy/fixtures/rules/disallowed-methods"
  ],
  "files": {
    ".gitignore": "target/\n",
    "policy/ratchets/disallowed-methods.json": {
      "version": 1,
      "family": "disallowed-methods",
      "ledger": "2.1-M223",
      "tool": "clippy",
      "scope": [
        "**"
      ],
      "lane": "push",
      "keys": "path-rule",
      "select": [
        "clippy::disallowed_methods"
      ],
      "entries": {}
