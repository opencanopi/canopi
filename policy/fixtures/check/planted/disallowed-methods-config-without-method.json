  "about": "Under a repository clippy.toml that no longer lists the method the planted crate calls, the disallowed-methods family's real planted directory is silent, so dropping the method from the real config fails the self-test",
  "copy": {
    "policy/adapters/clippy.mjs": "policy/adapters/clippy.mjs"
  },
  "expect": [
    "planted-silent"
  ]
