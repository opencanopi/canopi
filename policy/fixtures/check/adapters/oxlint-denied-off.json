{
  "about": "A denied rule set to off is no refusal: the config may name it to turn it off",
  "tool": "oxlint",
  "files": {
    "desktop/web/.oxlintrc.json": {
      "plugins": [
        "eslint",
        "typescript",
        "import",
        "vitest"
      ],
      "categories": {
        "correctness": "off",
        "suspicious": "off",
        "pedantic": "off",
        "perf": "off",
        "style": "off",
        "restriction": "off",
        "nursery": "off"
      },
      "rules": {
        "no-var": "error",
        "no-console": "off",
        "import/no-cycle": 0
      }
    },
    "desktop/web/src/a.ts": "export const a = 1\n"
  },
  "paths": [
    "desktop/web/src/a.ts"
  ],
  "stdout": "{\"diagnostics\": [], \"number_of_files\": 1, \"number_of_rules\": 1, \"threads_count\": 8, \"start_time\": 0.01}",
  "status": 0,
  "expect": []
}
