{
  "about": "cargo-llvm-cov's --flag=value spelling counts like --flag value: an exclusion or a floor written with = is measured",
  "tool": "coverage",
  "files": {
    ".cargo/config.toml": "[alias]\ncov = \"llvm-cov --workspace --ignore-filename-regex rust_engine/comparison\\\\.rs --ignore-filename-regex=services --fail-under-lines=80 --fail-under-functions 76.9 --fail-under-regions=86.3\"\n"
  },
  "familyFile": "policy/ratchets/coverage.json",
  "expect": [
    "below-floor",
    "floor-globs",
    "stale",
    "cargo-llvm-cov lines=80",
    "cargo-llvm-cov functions=76.9",
    "cargo-llvm-cov regions=86.3",
    "cargo-llvm-cov exclude=[\"rust_engine/comparison\\\\.rs\",\"services\"]",
    "differs"
  ]
}
