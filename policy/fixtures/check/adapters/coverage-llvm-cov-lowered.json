{
  "about": "The gate's coverage run reads its floors from the family it is given: a lowered line floor and an added exclusion are below the floor and over other globs; the vitest floors it does not measure are stale",
  "tool": "coverage",
  "copy": {
    "policy/gate/llvm-cov.mjs": "policy/gate/llvm-cov.mjs"
  },
  "files": {
    "policy/ratchets/coverage.json": "{\"family\": \"coverage\", \"floors\": {\"cargo-llvm-cov\": {\"exclude\": [\"rust_engine/comparison\\\\.rs\", \"services/\"], \"floors\": {\"lines\": 80, \"functions\": 76.9, \"regions\": 87.9}}}}"
  },
  "paths": [
    "policy/gate/llvm-cov.mjs"
  ],
  "familyFile": "policy/ratchets/coverage.json",
  "expect": [
    "below-floor",
    "floor-globs",
    "stale",
    "cargo-llvm-cov lines=80",
    "cargo-llvm-cov functions=76.9",
    "cargo-llvm-cov regions=87.9",
    "cargo-llvm-cov exclude=[\"(?:rust_engine/comparison\\\\.rs)|(?:services/)\"]",
    "differs"
  ]
}
