{
  "name": "canopi-web",
  "private": true,
  "version": "2.0.3",
  "type": "module",
  "engines": {
    "node": "^24.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "npm run typecheck && npm run build:desktop:bundle",
    "build:desktop:bundle": "vite build && node scripts/check-build-identifiers.mjs dist",
    "build:web": "npm run typecheck && npm run build:web:bundle",
    "build:web:bundle": "vite build --mode web && node scripts/check-web-build-boundaries.mjs && node scripts/check-build-identifiers.mjs dist-web",
    "build:web:root": "CANOPI_WEB_BASE_PATH=/ npm run build:web",
    "package:web": "npm run build:web && node scripts/package-web-edition.mjs",
    "package:web:root": "CANOPI_WEB_BASE_PATH=/ npm run package:web",
    "generate:web-catalog": "cd ../.. && python3 scripts/generate-web-catalog.py",
    "typecheck": "node ./node_modules/typescript7/bin/tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:policies": "node ../../policy/check.mjs --self-test && node ../../policy/check.mjs && vitest run src/__tests__/frontend-architecture-policies.test.ts src/__tests__/canvas-command-boundary.test.ts src/__tests__/unused-code.test.ts",
    "test:policies:push": "node ../../policy/check.mjs --self-test --lane push && node ../../policy/check.mjs --lane push",
    "test:policies:a11y": "node ../../policy/check.mjs --self-test --lane ci --family axe && node ../../policy/check.mjs --lane ci --family axe",
    "test:coverage": "vitest run --coverage --testTimeout=120000 --exclude '**/frontend-architecture-policies.test.ts' --exclude '**/canvas-command-boundary.test.ts' --exclude '**/unused-code.test.ts'",
    "gen:types": "cargo run -p bindings-gen",
    "check:web-catalog-artifact": "cd ../.. && python3 scripts/web_catalog_artifact_contract.py check",
    "check:types": "cargo run -p bindings-gen -- --check",
    "prepare": "cd ../.. && husky desktop/web/.husky",
    "prepare:pdf-fonts": "node scripts/prepare-pdf-fonts.mjs",
    "predev": "npm run prepare:pdf-fonts",
    "prebuild": "npm run prepare:pdf-fonts",
    "prebuild:web": "npm run prepare:pdf-fonts",
    "pretest": "npm run prepare:pdf-fonts",
    "pretest:coverage": "npm run prepare:pdf-fonts",
    "build:pdf-validation": "npm run prepare:pdf-fonts && npm run typecheck -- -p scripts/pdf-validation/tsconfig.json && vite build --config scripts/pdf-validation/vite.config.mjs",
    "dev:ui": "vite --config ui-gallery/vite.config.ts",
    "check:ui": "npm run typecheck -- -p ui-gallery/tsconfig.json",
    "check:editions": "npm run typecheck && npm run check:ui && npm run build:desktop:bundle && npm run build:web:bundle",
    "predev:web": "npm run prepare:pdf-fonts",
    "precheck:editions": "npm run prepare:pdf-fonts",
    "build:e2e": "cd .. && npx --prefix web @tauri-apps/cli@2.12.3 build --debug --no-bundle --features e2e --config '{\"identifier\":\"com.canopi.e2e\"}'",
    "test:platform": "wdio run e2e/platform/wdio.desktop.conf.ts"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/geo-layers": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/mapbox": "9.4.0",
    "@deck.gl/mesh-layers": "9.4.0",
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/literata": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "@luma.gl/core": "9.4.1",
    "@luma.gl/engine": "9.4.1",
    "@luma.gl/shadertools": "9.4.1",
    "@luma.gl/webgl": "9.4.1",
    "@preact/signals": "^2.11.3",
    "@tanstack/virtual-core": "^3.13.23",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "cog-tiler-wasm": "0.4.0",
    "fontkit": "2.0.4",
    "geotiff": "3.0.5",
    "geotiff-geokeys-to-proj4": "2026.8.16",
    "i18next": "^26.5.4",
    "maplibre-contour": "0.1.1",
    "maplibre-gl": "6.10.0",
    "maplibre-gl-raster": "0.14.15",
    "pdfkit": "0.20.2",
    "pixi.js": "^8.17.1",
    "preact": "^11.0.1",
    "proj4": "2.22.0",
    "whitebox-wasm": "0.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "^2.9.0",
    "@types/node": "~24.13.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@wdio/cli": "10.0.2",
    "@wdio/globals": "10.0.2",
    "@wdio/local-runner": "10.0.2",
    "@wdio/mocha-framework": "10.0.1",
    "@wdio/spec-reporter": "10.0.1",
    "expect-webdriverio": "8.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "rolldown": "~1.2.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "webdriverio": "10.0.2"
  },
  "overrides": {
    "image-size": "^2.0.4",
    "fflate": "^0.8.3",
    "texture-compressor": {
      "argparse": "^2.0.1"
    }
  }
}
