{
  "name": "canopi-web",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "engines": {
    "node": "^22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "tsc && npm run build:desktop:bundle",
    "build:desktop:bundle": "vite build",
    "build:web": "tsc && npm run build:web:bundle",
    "build:web:bundle": "vite build --mode web && node scripts/check-web-build-boundaries.mjs",
    "build:web:root": "CANOPI_WEB_BASE_PATH=/ npm run build:web",
    "package:web": "npm run build:web && node scripts/package-web-edition.mjs",
    "package:web:root": "CANOPI_WEB_BASE_PATH=/ npm run package:web",
    "generate:web-catalog": "cd ../.. && python3 scripts/generate-web-catalog.py",
    "preview": "vite preview",
    "test": "vitest run",
    "test:policies": "vitest run src/__tests__/frontend-architecture-policies.test.ts src/__tests__/canvas-command-boundary.test.ts src/__tests__/unused-code.test.ts",
    "test:coverage": "vitest run --coverage --testTimeout=120000 --exclude '**/frontend-architecture-policies.test.ts' --exclude '**/canvas-command-boundary.test.ts' --exclude '**/unused-code.test.ts'",
    "gen:types": "cargo run -p bindings-gen",
    "check:web-catalog-artifact": "cd ../.. && python3 scripts/web_catalog_artifact_contract.py check",
    "check:types": "cargo run -p bindings-gen -- --check",
    "prepare": "cd ../.. && husky desktop/web/.husky",
    "prepare:pdf-fonts": "node scripts/prepare-pdf-fonts.mjs",
    "predev": "npm run prepare:pdf-fonts",
    "prebuild": "npm run prepare:pdf-fonts",
    "prebuild:web": "npm run prepare:pdf-fonts",
    "pretest": "npm run prepare:pdf-fonts",
    "pretest:coverage": "npm run prepare:pdf-fonts",
    "build:pdf-validation": "npm run prepare:pdf-fonts && tsc -p scripts/pdf-validation/tsconfig.json && vite build --config scripts/pdf-validation/vite.config.mjs && node scripts/pdf-validation/copy-fonts.mjs",
    "dev:ui": "vite --config ui-gallery/vite.config.ts",
    "check:ui": "tsc --noEmit -p ui-gallery/tsconfig.json",
    "check:editions": "tsc && npm run check:ui && npm run build:desktop:bundle && npm run build:web:bundle",
    "predev:web": "npm run prepare:pdf-fonts",
    "precheck:editions": "npm run prepare:pdf-fonts"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/geo-layers": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/mapbox": "9.4.0",
    "@deck.gl/mesh-layers": "9.4.0",
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/literata": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "@luma.gl/core": "9.4.1",
    "@luma.gl/engine": "9.4.1",
    "@luma.gl/shadertools": "9.4.1",
    "@luma.gl/webgl": "9.4.1",
    "@preact/signals": "^2.0.0",
    "@tanstack/virtual-core": "^3.13.23",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "cog-tiler-wasm": "0.4.0",
    "fontkit": "2.0.4",
    "geotiff": "3.0.5",
    "geotiff-geokeys-to-proj4": "2026.8.16",
    "i18next": "^24.0.0",
    "maplibre-contour": "0.1.1",
    "maplibre-gl": "6.10.0",
    "maplibre-gl-raster": "0.14.15",
    "pdfkit": "0.20.2",
    "pixi.js": "^8.17.1",
    "preact": "^10.25.0",
    "proj4": "2.22.0",
    "whitebox-wasm": "0.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.9.0",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.1"
  },
  "overrides": {
    "image-size": "^2.0.4",
    "fflate": "^0.8.3"
  }
}
