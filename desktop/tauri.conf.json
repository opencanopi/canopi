{
  "productName": "Canopi",
  "version": "2.0.3",
  "identifier": "com.canopi.app",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "web"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "web"
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "web/dist"
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/image-cache/**",
          "$APPDATA/lidar/display-cog/*.tif"
        ]
      },
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "connect-src": "'self' ipc: http://ipc.localhost https: asset: http://asset.localhost",
        "worker-src": "'self' blob:",
        "child-src": "'self' blob:",
        "font-src": "'self' data:"
      },
      "capabilities": [
        "main-window"
      ]
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Canopi",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/canopi-core.db": "resources/canopi-core.db",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "externalBin": [
      "binaries/geolibre"
    ],
    "category": "Education",
    "fileAssociations": [
      {
        "ext": ["canopi"],
        "name": "Canopi Design",
        "description": "Canopi design",
        "mimeType": "application/x-canopi",
        "role": "Editor"
      }
    ],
    "shortDescription": "Agroecological garden design tool",
    "longDescription": "Canopi is an agroecological design application for planning and managing gardens, food forests, and permaculture systems.",
    "linux": {
      "deb": {
        "section": "science",
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.1-0t64",
          "libgtk-3-0 | libgtk-3-0t64"
        ],
        "desktopTemplate": "linux/canopi.desktop.hbs",
        "files": {
          "/usr/share/mime/packages/canopi.xml": "linux/canopi-mime.xml"
        },
        "postInstallScript": "linux/postinst.sh"
      }
    },
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "French",
          "Spanish",
          "PortugueseBR",
          "Italian",
          "SimpChinese",
          "German",
          "Japanese",
          "Korean",
          "Dutch",
          "Russian"
        ],
        "displayLanguageSelector": true
      },
      "wix": {
        "upgradeCode": "EEBF4EA9-A99E-5493-953A-AA0DBF45B8D5"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzOUU5QTY1NDU5ODk1NDgKUldSSWxaaEZaWnFlVStMdU1BdXFsckxteGhIaE1scVVzMDV0YzEvUlMyR25UbjlPUjI4QVFVbVgK",
      "requireSignedVersion": true,
      "allowDowngrades": false
    }
  }
}
